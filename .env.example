# AIive Configuration
# Copy this file to .env and fill in your values.

# LLM (OpenAI-compatible)
AIIVE_LLM_API_KEY=your-api-key-here
AIIVE_LLM_BASE_URL=https://api.deepseek.com/v1
AIIVE_LLM_MODEL=deepseek-chat
AIIVE_LLM_TIMEOUT_SECONDS=30
AIIVE_LLM_JSON_MODE=auto
AIIVE_LLM_STREAM_USAGE=true
TOOL_ARGUMENT_MAX_RETRIES=2

# 工具结果回填预算（防止一次性返回大内容撑爆 LLM 上下文）
# 超过阈值的结果会完整落盘到 TOOL_OUTPUT_DIR，模型只看到有界摘要与日志路径。
TOOL_OUTPUT_DIR=.data/tool_outputs
# 日志保留小时数：超过该时长的日志由调度器删除
TOOL_OUTPUT_RETENTION_HOURS=10
# 过期日志扫描周期（小时）
TOOL_OUTPUT_CLEANUP_INTERVAL_HOURS=5

# Public web research (all returned content is treated as untrusted evidence)
AIIVE_WEB_SEARCH_ENABLED=true
# duckduckgo requires no key; brave and searxng require the matching setting below.
AIIVE_WEB_SEARCH_PROVIDER=duckduckgo
AIIVE_BRAVE_SEARCH_API_KEY=
AIIVE_SEARXNG_BASE_URL=
AIIVE_WEB_REQUEST_TIMEOUT_SECONDS=15
AIIVE_WEB_MAX_RESPONSE_BYTES=2000000
AIIVE_WEB_USER_AGENT=AIive/0.1 (+local-personal-agent)
# Optional local document roots, separated by the platform path separator.
# Default: ~/Documents and .data/knowledge
AIIVE_KNOWLEDGE_ROOTS=
# Electron Desktop Node 在线租约与普通调度默认超时
AIIVE_DESKTOP_NODE_LEASE_SECONDS=45
AIIVE_DESKTOP_DISPATCH_TIMEOUT_SECONDS=30
AIIVE_DESKTOP_NODE_AUTH_TOKEN=aiive-desktop-dev-token
AIIVE_DESKTOP_PROTOCOL_VERSION=2
AIIVE_TRUSTED_CORE_ADMIN_TOKEN=aiive-trusted-core-dev-token

# 单用户登录（V49）：首次启动后到 /login 完成一次性注册，之后所有 HTTP 与 WebSocket 都需要 Bearer Token。
# AIIVE_AUTH_SECRET 留空时首次启动自动生成并写入 AIIVE_AUTH_SECRET_FILE，重启后已签发 Token 继续有效。
# 非 loopback 部署不允许关闭 AIIVE_AUTH_ENABLED。
AIIVE_AUTH_ENABLED=true
AIIVE_AUTH_SECRET=
AIIVE_AUTH_SECRET_FILE=.data/auth_secret
AIIVE_AUTH_TOKEN_DAYS=365
AIIVE_AUTH_LOGIN_MAX_ATTEMPTS=5
AIIVE_AUTH_LOGIN_WINDOW_SECONDS=900

# Memory Vector Recall (local TEI/OpenAI-compatible Embeddings + pgvector)
# local: scripts/start.sh 检测并自动下载模型后拉起 TEI（缓存见 AIIVE_LOCAL_EMBEDDING_CACHE_DIR）。
# openai_compatible: 使用远端 /v1/embeddings，此时必须填写 API key。
AIIVE_MEMORY_VECTOR_ENABLED=false
AIIVE_EMBEDDING_PROVIDER=local
AIIVE_EMBEDDING_API_KEY=
AIIVE_EMBEDDING_BASE_URL=http://127.0.0.1:8081/v1
AIIVE_EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
AIIVE_EMBEDDING_MODEL_REVISION=534b6bfaaf500e70bcb9f3771cebc940c23b219d
AIIVE_EMBEDDING_DIMENSIONS=512
AIIVE_EMBEDDING_QUERY_PREFIX=为这个句子生成表示以用于检索相关文章：
AIIVE_EMBEDDING_TIMEOUT_SECONDS=5
# 单次 Embeddings 请求的最大文本条数（本地 TEI cpu 后端 max_batch_requests 通常为 4）。
AIIVE_EMBEDDING_BATCH_SIZE=4
AIIVE_MEMORY_VECTOR_TOP_K=16
# Knowledge Chunk Vector Recall（与记忆共用同一模型与 pgvector）
# 开启后知识检索为"关键词 + 向量"混合召回；Embedding 故障时自动退化为纯关键词。
# 需要 PostgreSQL + pgvector（SQLite 部署请保持 false）。
AIIVE_KNOWLEDGE_VECTOR_ENABLED=false
AIIVE_KNOWLEDGE_VECTOR_TOP_K=16
# 向量召回相似度下限：低于该值的分块不进入混合结果（按模型实测分布标定）。
AIIVE_KNOWLEDGE_VECTOR_MIN_SIMILARITY=0.30
# 单次维护回填最多处理的分块所属文档数（有界批次）。
AIIVE_KNOWLEDGE_VECTOR_BACKFILL_BATCH=200
AIIVE_LOCAL_EMBEDDING_PORT=8081
AIIVE_LOCAL_EMBEDDING_MAX_CONCURRENCY=32
AIIVE_LOCAL_EMBEDDING_STARTUP_TIMEOUT_SECONDS=600
# 模型缓存目录（相对仓库根目录）。scripts/embedding_model.sh 按此路径检测是否已下载。
AIIVE_LOCAL_EMBEDDING_CACHE_DIR=.data/models/embeddings
# 模型权重下载源候选，逗号分隔按顺序尝试；单个源失败（容器退出或超时）自动换下一个。
# 只用一个源时可直接设置 AIIVE_HF_ENDPOINT，设置后不再尝试候选列表。
AIIVE_HF_ENDPOINT_CANDIDATES=https://huggingface.co,https://hf-mirror.com
# 留空时 scripts/start.sh 根据 CPU 架构选择 cpu-1.9 / cpu-arm64-1.9。
AIIVE_TEI_IMAGE_TAG=

# Memory File Projection (derived Markdown + JSON view)
AIIVE_MEMORY_FILE_PROJECTION_ENABLED=true
AIIVE_MEMORY_FILE_PROJECTION_DIR=.data/memory_projection

# Database
DATABASE_URL=postgresql+psycopg://aiive:aiive_dev@localhost:5432/aiive

# Server
HOST=127.0.0.1
PORT=8000
# Web 与 Android WebView 的允许来源，逗号分隔；生产部署时追加真实 Web 域名。
AIIVE_CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost,https://localhost,capacitor://localhost

# Local-only developer diagnostics (backend, default off)
AIIVE_DEVELOPER_DIAGNOSTICS_ENABLED=false

# Self-evolution safety-gate result directory (optional override).
# Default: <repo>/runtime/eval_runs (auto-detected repo root). Set this when the
# backend runs from an installed layout and you want results in a known volume.
# AIIVE_EVAL_RUNS_DIR=

# Developer UI route (frontend build-time flag, default off)
VITE_AIIVE_DEVELOPER_UI_ENABLED=false
