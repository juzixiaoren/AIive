[Unit]
Description=AIive encrypted local backup
Requires=docker.service
After=docker.service

[Service]
Type=oneshot
User=root
UMask=0077
ExecStart=/usr/bin/bash /opt/aiive/scripts/backup/backup.sh
StandardOutput=journal
StandardError=journal
TimeoutStartSec=infinity
TimeoutStopSec=300
KillMode=mixed
